# ============================================================
#  Gisoo Trader | گیسو تریدر — configuration
#  Copy to .env and fill in. NEVER commit .env or share it.
#  start.ps1 / start.sh create .env from this file with random secrets.
# ============================================================

TZ=Asia/Tehran

# ---------- Runtime mode ----------
# paper   = real market data, simulated money (no exchange keys needed) <- start here
# testnet = Binance Spot testnet only (needs testnet keys)
# live    = REAL MONEY on the selected exchange
TRADING_MODE=paper

# The engine places no live order until this is true. Flip it here or from
# the panel (Settings -> Arm trading; live requires typing ARM LIVE).
TRADING_ARMED=false

# ---------- Exchange ----------
# binance  = reference connector (full feature set)
# nobitex | wallex | bitpin | ramzinex | okex = Iranian spot exchanges (BETA:
#            written against each exchange's public API docs, not yet run with
#            real money on every exchange - see docs/exchanges.md)
EXCHANGE=binance
# Credentials of the selected exchange. Create a key with TRADE permission
# only - NEVER withdrawal - and lock it to this server's IP where possible.
#   nobitex : API key = public key, secret = Ed25519 private key
#             (or a login token as the key and an empty secret)
#   wallex  : API key only (secret unused)
#   bitpin, ramzinex, okex : API key + secret
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Binance-specific names (still honoured; they win over EXCHANGE_API_*).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Binance only: pay fees with BNB (25% discount). Keep a little BNB in Spot.
BINANCE_USE_BNB_FEES=true
# Outbound proxy for the exchange connection (leave empty if not needed).
# Only use an exchange that is legally available to you, and follow its terms.
EXCHANGE_HTTP_PROXY=
# Exchanges without a candle websocket (all Iranian ones) are polled this often, seconds.
EXCHANGE_POLL_SECONDS=30
# Override the connector's REST base URL (mirrors). Empty = the documented default.
EXCHANGE_BASE_URL=

# ---------- Universe & timeframes ----------
# USDT on every exchange; IRT (Toman) on the Iranian ones. Start with USDT:
# Toman markets go through Rial/Toman conversions that are still beta.
QUOTE_ASSET=USDT
# Symbols the bot may trade, comma separated, written BASE+QUOTE
# (BTCUSDT, ETHUSDT ... or BTCIRT, ETHIRT ... for Toman). BTC+QUOTE is always
# followed for the market gate even if you leave it out here.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,LINKUSDT,DOTUSDT,AVAXUSDT,LTCUSDT,ATOMUSDT
# Iranian exchanges list fewer coins; a symbol the exchange does not have is
# skipped with a warning. A smaller example for them:
#SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,LINKUSDT,DOTUSDT,AVAXUSDT,LTCUSDT
# Decision timeframe / higher timeframe - ensemble30m core only.
TIMEFRAME=30m
HTF_TIMEFRAME=4h
# Candles kept / backfilled per symbol. The 4h core needs at least 300; on the
# Iranian exchanges 600 keeps the first backfill short (it is rate-limited).
CANDLE_HISTORY=1500

# ---------- Strategy core ----------
# portfolio4h = two BTC-regime-gated 4h families (cross-sectional momentum +
#               55/20 channel breakout), tested on 12 historical regime
#               windows 2021-2026 (app/research). Default.
# ensemble30m = the older six-strategy ensemble (needs 30m candles; Binance,
#               Nobitex, Bitpin and Ramzinex only). Kept for comparison.
STRATEGY_CORE=portfolio4h
# Caution factor on the 4h families' risk per trade: 1.0 = as tested,
# 0.67 = conservative.
CORE4H_RISK_SCALE=1.0

# ---------- Capital & risk ----------
# Paper-mode starting balance and first capital base, in QUOTE_ASSET units.
INITIAL_CAPITAL_USDT=100
# % of equity risked per trade (ensemble30m only; portfolio4h sizes per family).
RISK_PER_TRADE_PCT=1.5
MAX_CONCURRENT_POSITIONS=4
# New entries pause for the rest of the UTC day past this loss.
MAX_DAILY_LOSS_PCT=5
# Kill switch - manual re-arm in the panel (closed-equity drawdown under portfolio4h).
MAX_DRAWDOWN_PCT=20
MIN_EXPECTED_MOVE_PCT=0.8
MAX_POSITION_PCT=35
# Your real taker fee, %: Binance 0.1 (0.075 with BNB); Iranian exchanges are
# typically 0.2-0.35 - check your fee tier and set it here.
TAKER_FEE_PCT=0.075

# ---------- Futures (Binance only, off by default, not validated) ----------
FUTURES_ENABLED=false
FUTURES_LEVERAGE=2
FUTURES_MARGIN_MODE=ISOLATED

# ---------- Strategy ensemble (STRATEGY_CORE=ensemble30m only) ----------
MIN_SIGNAL_SCORE=0.62
ATR_STOP_MULT=3.0
ATR_TARGET_MULT=4.5
TRAILING_ENABLED=true
TRAILING_ACTIVATE_R=1.0
TRAILING_ATR_MULT=1.4
COOLDOWN_MINUTES_AFTER_LOSS=45
MIN_ATR_RATIO=1.5
# The 4h portfolio core was tested WITH weekend rebalances: keep false for it.
SKIP_WEEKEND_ENTRIES=false
SKIP_ENTRY_HOURS_UTC=
# Symbols kept for data but never traded, e.g. XRPUSDT
EXCLUDED_SYMBOLS=

# ---------- ML layer (ensemble30m only) ----------
ML_ENABLED=true
ML_MIN_PROBABILITY=0.55
ML_RETRAIN_HOURS=24
ML_LOOKAHEAD_BARS=12

# ---------- AI advisor (optional) ----------
# The advisor may veto or shrink a trade, never open one. Without it the
# quantitative rules trade on their own.
LLM_ENABLED=false
# auto | gisoo | netarz | anthropic | openai | deepseek
# auto = the first of these that has a key.
LLM_PROVIDER=auto
# Tried once when the primary fails: none | gisoo | netarz | anthropic | openai | deepseek
LLM_FALLBACK_PROVIDER=none
# Gisoo (https://gisoo.pro): Persian AI app and OpenAI-compatible API, 400+
# models with one key, credit paid in Toman. Key format sk-gisoo-v1-...
GISOO_API_KEY=
#GISOO_BASE_URL=https://gisoo.pro/api/v1
# NetArz AI API (https://netarz.ir/ai-api): OpenAI-compatible, GPT, Gemini,
# DeepSeek and Claude (as openrouter/anthropic/<model>). Key sk-ntz-v1-...
NETARZ_AI_API_KEY=
#NETARZ_AI_BASE_URL=https://netarz.ir/api/ai/v1
ANTHROPIC_API_KEY=
# Anthropic SDK through Gisoo: set https://gisoo.pro/api (no /v1) and use a
# Gisoo key as ANTHROPIC_API_KEY.
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Model for the primary / the fallback. Empty = the provider default:
#   gisoo, netarz -> gpt-4o-mini (any model id the gateway lists works)
#   anthropic     -> claude-opus-5
#   openai        -> the best of gpt-5-mini, gpt-5, gpt-4.1-mini, gpt-4o-mini the key can use
#   deepseek      -> deepseek-chat
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Anthropic output_config.effort / OpenAI reasoning_effort. Keep it low.
LLM_EFFORT=low
# Proxy for the LLM APIs only. Empty = EXCHANGE_HTTP_PROXY, "direct" = none.
LLM_HTTP_PROXY=
LLM_REVIEW_MINUTES=30
LLM_CAN_VETO=true
LLM_DAILY_CALL_BUDGET=120
#OPENAI_BASE_URL=https://api.openai.com/v1
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- AI committee (optional, needs the advisor above) ----------
# Twice a day: a numeric briefing + the policy (app/committee/policy.md) go to
# the advisor; only the stance / risk multiplier for NEW entries is applied
# automatically, everything else is a proposal you approve on «کمیته».
COMMITTEE_ENABLED=false
# Meeting hours, UTC (4,16 = 07:35 and 19:35 Tehran time).
COMMITTEE_HOURS_UTC=4,16
# Your own copy of the policy. Empty = app/committee/policy.md.
#COMMITTEE_POLICY_PATH=

# ---------- NetArz FX (optional): equity in Toman on the dashboard ----------
# https://netarz.ir/fx-api - free plan (delayed rates) needs only an account.
# Server calls must come from an IP you list on the NetArz app. Key fx-ntz-v1-...
NETARZ_FX_KEY=
# Which rate converts the quote asset to Toman (USD is the usual proxy for USDT).
NETARZ_FX_CODE=USD

# ---------- Panel auth ----------
PANEL_USERNAME=admin
# Preferred: a bcrypt hash of the panel password. Generate it with
#   docker compose run --rm --no-deps engine python -m app.api.hash_password "your password"
# and paste the printed line here. KEEP THE SINGLE QUOTES (the hash contains $).
# When set, PANEL_PASSWORD is ignored.
PANEL_PASSWORD_HASH=''
# Plaintext fallback, only used while PANEL_PASSWORD_HASH is empty. The start
# scripts replace this placeholder with a random password; while it is still
# the placeholder every login is refused.
PANEL_PASSWORD=change-me-now
# Random 32+ char string (the start scripts generate one): openssl rand -hex 32
# No session token is issued while it is the placeholder or shorter.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
# Browser origins allowed to call the API cross-origin, comma separated.
# Empty = same-origin only (what the Caddy setup needs).
PANEL_ORIGINS=
TRUSTED_PROXIES=caddy,127.0.0.1,::1
# Two-factor (TOTP) and passkeys (hardware security keys, phone passkeys) are
# switched on from the panel: «بیشتر» -> «امنیت». A passkey is bound to the
# host it was enrolled on, so enrol it once per host (localhost / your domain).
# Origins a passkey response may come from. Empty = PANEL_ORIGINS plus
# http://localhost:8090 and http://localhost:5173. Put your public HTTPS
# origin here or in PANEL_ORIGINS, e.g. https://trader.example.com
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Gisoo Trader
PASSKEY_REQUIRED=false

# ---------- Notifications ----------
# Telegram: @BotFather -> /newbot -> token here -> restart -> send /start to
# your bot (the chat id is detected automatically). Web Push: panel ->
# «بیشتر» -> «اعلان‌ها» (needs HTTPS or localhost).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Contact behind the Web Push signature (an email or a mailto:/https: URL).
NOTIFY_CONTACT=mailto:admin@localhost
NOTIFY_HTTP_PROXY=

# ---------- Infrastructure ----------
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=trader
# The panel listens on PANEL_BIND:PANEL_PORT. 127.0.0.1 = this computer only
# (default); 0.0.0.0 = every network this computer is on (LAN phones).
PANEL_BIND=127.0.0.1
PANEL_PORT=8090
# Public hostname on a VPS (Caddy gets a Let's Encrypt certificate) together
# with COMPOSE_FILE below. Leave :80 for local use.
PUBLIC_SITE_ADDRESS=:80
#COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ---------- Cloudflare Tunnel (optional, HTTPS without opening ports) ----------
# Zero Trust -> Networks -> Tunnels -> Create -> token below; public hostname
# -> HTTP -> caddy:80; then COMPOSE_PROFILES=tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
#COMPOSE_PROFILES=tunnel
